{
  "appId": "io.github.vishstack01.careeros",
  "appName": "CareerOS",
  "webDir": "www",
  "server": {
    "url": "https://careeros-web.onrender.com",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "CareerOSApp/1.0 (Android)",
    "allowMixedContent": false,
    "backgroundColor": "#FAF3E6"
  },
  "ios": {
    "appendUserAgent": "CareerOSApp/1.0 (iOS)",
    "backgroundColor": "#FAF3E6",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  }
}
