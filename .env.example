# CareerOS: bring your own model.
# Copy this file to .env (it is git-ignored) and fill in ONE provider.
# CareerOS reads it when you run any `careeros` command from this folder.
# Your key stays on your machine: it is sent only to the provider you choose.

# anthropic | openai | gemini | ollama
CAREEROS_LLM=anthropic

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible API (OpenRouter, Groq, Together, a local vLLM...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
# GEMINI_API_KEY=

# Ollama: free and fully local, no key
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional: pin models (defaults are picked per provider)
# CAREEROS_MODEL=
# CAREEROS_MODEL_QUICK=

# ======================================================================
# Optional: CareerOS Cloud (the multi-user service, docker compose)
# ======================================================================

# --- Database (docker compose builds DATABASE_URL from this password) ---
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password

# --- Where the app runs ---
# development: SQLite or Postgres, emails printed to the log, migrations applied automatically.
# staging / production: requires PostgreSQL, an https PUBLIC_URL and SMTP; run `careeros cloud migrate` as a release step.
APP_ENV=development
PUBLIC_URL=http://127.0.0.1:8000
# Set to 1 only behind a reverse proxy you control (the caddy profile, Render, Fly).
TRUST_PROXY=0

# --- Email (sign-up confirmation, password reset) ---
# smtp://user:password@smtp.example.com:587 (STARTTLS) or smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=CareerOS <no-reply@example.com>

# --- Accounts ---
# The first account with this email becomes the operator (sees /api/admin/overview).
BOOTSTRAP_ADMIN_EMAIL=
# open | allowlist | closed. For a private beta use allowlist with emails or @domains.
SIGNUP_MODE=open
# Optional "Continue with LinkedIn" (Sign in with LinkedIn using OpenID Connect): name, email and photo only.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SIGNUP_ALLOWLIST=
SESSION_TTL_DAYS=14

# --- Plans, payments and the hosted AI allowance ---
# Encrypts users' own model keys at rest. Required in production: any random string of 32+ characters.
SECRETS_KEY=
# Shown on the policy pages and pricing. Razorpay needs a working support address.
SUPPORT_EMAIL=
COMPANY_NAME=CareerOS
PRO_PRICE_INR=299
FREE_AI_CREDITS=15
PRO_AI_CREDITS=400
# The service's own model for the monthly AI allowance uses CAREEROS_LLM and the provider key at the top of this file.
# Razorpay (Settings > API keys, Subscriptions > Plans, Settings > Webhooks). Set all four, or none to keep checkout off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=

# --- Files ---
MAX_UPLOAD_MB=5
USER_STORAGE_MB=25

# --- Job inventory ---
# The hourly scan's public feed. Point at your fork's feed branch if you run your own scan.
FEED_URL=https://raw.githubusercontent.com/VishStack01/careeros/feed/feed/
INGEST_EVERY_MINUTES=60

# --- Tuning ---
DB_POOL_MIN=1
DB_POOL_MAX=10
WORKER_POLL_SECONDS=5
