{
  "manifest_version": 3,
  "name": "CareerOS Autofill",
  "short_name": "CareerOS",
  "version": "1.2.0",
  "description": "Fills job application forms from your CareerOS profile. You review every answer and press Submit yourself.",
  "action": {
    "default_title": "CareerOS Autofill",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "minimum_chrome_version": "110"
}
